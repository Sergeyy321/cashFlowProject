  VITE_apiKey=AIzaSyClRmDuGFwVjK_l78c_AcMTn3NZpVC8c-Y
  VITE_authDomain=cashflow-ec8ed.firebaseapp.com
  VITE_projectId=cashflow-ec8ed
  VITE_storageBucket=cashflow-ec8ed.firebasestorage.app
  VITE_messagingSenderId=306485575686
  VITE_appId1=306485575686:web:30edc4a377c527fa958387
  VITE_measurementId=G-EYVZL9EQEM
  VITE_URL=https://script.google.com/macros/s/AKfycbwCpYaxFEZLfYDSf1tcGUeCmOVPB5w7yaO6lW9kr-vpWqUxLUjs5K1LcX8Iw613jZTy/exec
  function doPost(e) {
  try {
    Logger.log(JSON.stringify(e));

    const spreadsheet = SpreadsheetApp.openById(
      "1VtWqmzFpy4ukm23jTshqsFpF5TBwnurZgS9s2gc8DLU"
    );

    /*
     * ==========================================
     * WOOD IQ
     * ==========================================
     */

    if (e.parameter.orderType === "woodiq") {

      const sheet = spreadsheet.getSheetByName("WoodIQ");

      if (!sheet) {
        throw new Error('Лист "WoodIQ" не найден');
      }

      sheet.appendRow([
        Utilities.getUuid(),              // ID
        new Date(),                       // Дата

        e.parameter.name || "",           // Имя
        e.parameter.phone || "",          // Телефон
        e.parameter.messenger || "",      // Связь
        e.parameter.city || "",           // Город

        e.parameter.type || "",            // rental / purchase
        Number(e.parameter.games || 0),   // Количество игр
        Number(e.parameter.days || 0),    // Дни

        e.parameter.delivery || "нет",  // Доставка

        Number(e.parameter.price || 0),          // Цена игр
        Number(e.parameter.deliveryPrice || 0), // Цена доставки
        Number(e.parameter.total || 0),          // Итого

        e.parameter.comment || ""         // Комментарий
      ]);

      SpreadsheetApp.flush();

      return jsonResponse({
        success: true,
        orderType: "woodiq"
      });
    }


    /*
     * ==========================================
     * СТАРАЯ ФОРМА
     * ==========================================
     */

    const sheet = spreadsheet.getSheetByName("Participants");

    if (!sheet) {
      throw new Error('Лист "Participants" не найден');
    }

    sheet.appendRow([
      Utilities.getUuid(),
      new Date(),
      e.parameter.name || "",
      e.parameter.phone || "",
      e.parameter.messenger || "",
      e.parameter.city || "",
      e.parameter.tier || "",
      Number(e.parameter.participants || 1)
    ]);

    SpreadsheetApp.flush();

    return jsonResponse({
      success: true
    });

  } catch (error) {

    Logger.log("ERROR: " + error.toString());

    return jsonResponse({
      success: false,
      error: error.toString()
    });
  }
}
