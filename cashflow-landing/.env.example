# =========================================================================
# CONFIGURATION & STRIPE ARCHITECTURE ENVIRONMENT
# =========================================================================

# 1. Google Sheets & Email Notifications (Google Apps Script Web App)
VITE_URL=https://script.google.com/macros/s/AKfycbwP9Ahk0qLpSZi89NAHv3wELbUMC_vL1Yl88z0L7aLldFtYhOgS2xY0NXXFvYvUVflv/exec

# 2. Stripe Payment Integration (Frontend)
# Установите 'true', когда будете готовы принимать реальные/тестовые платежи через Stripe
VITE_STRIPE_ENABLED=false
VITE_PAYMENT_API_URL=/api/create-checkout-session

# 3. Stripe Secret Keys (ТОЛЬКО НА СЕРВЕРЕ / VERCEL ENVIRONMENT VARIABLES)
# ВНИМАНИЕ: Секретные ключи никогда не добавляются в Vite (без приставки VITE_)
# STRIPE_PUBLISHABLE_KEY=pk_test_... (или pk_live_...)
# STRIPE_SECRET_KEY=sk_test_... (или sk_live_...)
# STRIPE_WEBHOOK_SECRET=whsec_...
